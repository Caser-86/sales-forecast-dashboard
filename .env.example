# Docker Compose configuration template.
# Copy this file to .env before changing local demo settings.

ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave empty for the local demo. Set a strong value when ENV=production.
API_TOKEN=
API_TOKEN_HEADER=X-API-Token

FORECAST_DAYS=30
FORECAST_WORKERS=4
