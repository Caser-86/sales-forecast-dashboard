# ====================================================================
# 销售数据预测与可视化大屏 - 环境变量示例
# ====================================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按需修改各项配置
#   3. .env 文件不会被提交到 Git（已在 .gitignore 中忽略）
# ====================================================================

# ---------- 应用 ----------
APP_NAME=销售数据预测与可视化大屏 API
APP_VERSION=1.0.0
# 运行环境：development / production / test
ENV=development
# 调试模式，生产环境必须为 false
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---------- 安全 ----------
# CORS 允许的前端源，多个用英文逗号分隔
# 生产环境务必改为实际域名，例如：https://dashboard.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500
# 可选 API Token 认证（留空=不启用；填写后所有 /api/* 请求需带 X-API-Token 头）
API_TOKEN=
API_TOKEN_HEADER=X-API-Token

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ---------- 数据路径（一般不需修改）----------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=ml/saved_models

# ---------- 数据库（保留扩展点，当前未启用）----------
DATABASE_URL=sqlite:///dashboard.db

# ---------- 业务参数 ----------
FORECAST_DAYS=30
LSTM_SEQ_LEN=14

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
